# ============================================================
# 企业经营智能决策 Agent — .gitignore
# ⚠️ 敏感/大文件一律不提交（.env 含真实密码与 API Key）
# ============================================================

# ---------- WorkBuddy 项目内部记忆（非项目代码） ----------
.workbuddy/

# ---------- 环境变量与密钥（绝不上传） ----------
backend/.env
.env
!*.env.example

# ---------- 浏览器调试数据（含登录态/cookie，约 849MB） ----------
backend/data/edge_debug_profile/

# ---------- 爬取的经营业务报表（敏感经营数据） ----------
backend/data/scraped/

# ---------- 向量库（本地构建，体积大） ----------
chroma_db/
backend/chroma_db/

# ---------- 日志与运行时 ----------
backend/logs/
logs/
*.log

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# ---------- IDE / 系统 ----------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---------- 临时文件 ----------
tmp_*.py
*.tmp
