# ============================================================
# 企业经营智能决策与自动化执行 Agent 系统 — 环境变量示例
# 复制为 .env 并按需填写。
# ⚠️ 无 Mock 红线：未配置 LLM Key 时 create_llm 会抛明确错误（服务仍可启动，
#    对话会报错）；系统不存在任何模拟数据/降级假数据。
# ============================================================

# ---------- LLM 提供商：deepseek / openai_compatible / local / codebuddy ----------
BIZ_LLM_PROVIDER=deepseek

# DeepSeek（默认模型 deepseek-v4-flash；如账号仍在使用 deepseek-chat 可改）
BIZ_DEEPSEEK_API_KEY=
BIZ_DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI-compatible（支持商汤 SenseNova / vLLM / 中转服务等；openai 为旧兼容别名）
BIZ_OPENAI_API_KEY=
BIZ_OPENAI_MODEL=gpt-4o-mini
BIZ_OPENAI_BASE_URL=               # 留空 = 官方 api.openai.com；第三方端点必须显式配置，否则 key 无效导致 LLM 全部失败
BIZ_OPENAI_COMPATIBLE_API_KEY=     # 推荐新命名；优先级高于 BIZ_OPENAI_API_KEY
BIZ_OPENAI_COMPATIBLE_MODEL=       # 优先级高于 BIZ_OPENAI_MODEL
BIZ_OPENAI_COMPATIBLE_BASE_URL=    # 优先级高于 BIZ_OPENAI_BASE_URL

# 本地模型（vLLM / Ollama 等 OpenAI 兼容端点）
BIZ_LOCAL_BASE_URL=http://localhost:11434/v1
BIZ_LOCAL_MODEL=qwen2.5:14b

# CodeBuddy 通道（可选，workbuddy2api 本地代理，复用 WorkBuddy 账号额度，支持原生 tool calling）
# 切换：BIZ_LLM_PROVIDER=deepseek（默认）或 codebuddy；页面右上角 LLM 下拉可运行时切换（无需重启）
BIZ_CODEBUDDY_BASE_URL=http://127.0.0.1:8787/v1   # 8788=远程账号 ｜ 8787=本机账号
BIZ_CODEBUDDY_MODEL=glm-5.2        # 可用: glm-5.2 / glm-5.1 / kimi-k2.7 / deepseek-v4-flash / hy3-preview-agent 等
BIZ_CODEBUDDY_API_KEY=

BIZ_LLM_TEMPERATURE=0.3

# ---------- MySQL ----------
BIZ_DB_HOST=127.0.0.1
BIZ_DB_PORT=3306
BIZ_DB_USER=root
BIZ_DB_PASSWORD=your_password
BIZ_DB_NAME=business_agent

# 门店主数据 JSON（美团后台门店列表，含 search_keyword/budget_keyword）
BIZ_STORES_JSON=

# ---------- RAG 向量库：chroma / milvus ----------
BIZ_VECTOR_STORE_TYPE=chroma
BIZ_CHROMA_DIR=./chroma_db
BIZ_EMBEDDING_PROVIDER=chroma_default    # chroma_default / fastembed_bge_zh / fastembed_bge_m3 / openai

# ---------- 安全（API 鉴权） ----------
# 设置后所有非公开接口（/api/*、/docs 等）必须携带请求头：
#   Authorization: Bearer <token>   或   X-API-Token: <token>
# 留空 = 关闭鉴权（开发模式，启动时有警告）；生产/联调环境务必设置
BIZ_API_TOKEN=

# ---------- 自动化执行（阶段二） ----------
BIZ_PLAYWRIGHT_HEADLESS=true
BIZ_OPS_PLATFORM_URL=http://localhost:3000/ops   # 运营后台地址（模拟页）
