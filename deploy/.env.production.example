# 复制到项目根目录 .env 后填写真实值；不要提交 .env。
BIZ_LLM_PROVIDER=deepseek
BIZ_DEEPSEEK_API_KEY=
BIZ_DEEPSEEK_MODEL=deepseek-v4-flash

# 如使用第三方 OpenAI-compatible 模型：
# BIZ_LLM_PROVIDER=openai_compatible
# BIZ_OPENAI_COMPATIBLE_API_KEY=
# BIZ_OPENAI_COMPATIBLE_BASE_URL=https://provider.example/v1
# BIZ_OPENAI_COMPATIBLE_MODEL=provider-model

BIZ_DB_HOST=mysql
BIZ_DB_PORT=3306
BIZ_DB_USER=root
BIZ_DB_PASSWORD=
BIZ_DB_NAME=business_agent
BIZ_STORES_JSON=/app/data/stores.json
BIZ_CHROMA_DIR=/app/chroma_db
BIZ_VECTOR_STORE_TYPE=chroma
BIZ_EMBEDDING_PROVIDER=fastembed_bge_zh
BIZ_API_TOKEN=
BIZ_PLAYWRIGHT_HEADLESS=true
BIZ_OPS_PLATFORM_URL=http://localhost:3000/ops
